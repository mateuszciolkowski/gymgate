{
  "expo": {
    "name": "GymGate",
    "slug": "gymgate",
    "scheme": "gymgate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gymgate.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.gymgate.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D0C"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-dev-client",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
