{
  "name": "gymgate-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "jest",
    "gen:themes": "node tools/gen-themes.mjs",
    "db:generate": "drizzle-kit generate && node src/db/genMigrations.mjs",
    "test:parity": "jest --config jest.parity.config.js",
    "test:protocol": "jest --config jest.protocol.config.js --runInBand"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-constants": "^58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-font": "^58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "^58.0.17",
    "expo-router": "^58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "^58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "^58.0.5",
    "expo-system-ui": "^58.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
